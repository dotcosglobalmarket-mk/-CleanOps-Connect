# Committed intentionally — see .gitignore for why.
#
# Cloudflare Workers Builds has no build-time environment variables UI for
# assets-only Workers ("Runtime variables and secrets" explicitly doesn't
# apply, and there is no separate build-time equivalent), so this file is
# how Vite picks these up during `npm run build` in Cloudflare's Git
# integration.
#
# VITE_MAPBOX_TOKEN was flagged by GitHub push protection as a Mapbox
# Secret Access Token despite its "pk." prefix. The repo owner confirmed
# committing it is intentional after being told this.

VITE_API_URL=https://plankton-app-4k8kp.ondigitalocean.app
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiY2FyZWNvcmVwcm8zNjUiLCJhIjoiY210ZnpwN2xmMXNnbDJ3cXdrcmlyZXB4NSJ9.vMjDd2UCnDS3o6_I6XXoHg
