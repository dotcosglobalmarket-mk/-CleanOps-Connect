VITE_MAPBOX_TOKEN=pk.eyJ1IjoiY2FyZWNvcmVwcm8zNjUiLCJhIjoiY210ZnpwN2xmMXNnbDJ3cXdrcmlyZXB4NSJ9.vMjDd2UCnDS3o6_I6XXoHg
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51UUgUP0HgKMekLcyR6wBuv9TsXp0F6KHg8QE9YbmnUXA854ge0hoe1dfdi4UXbLqbTApRJtn3t5uytTW0qM1QRby00LC6h6nMC
