PORT=4000
MONGO_URI=
MAPBOX_API_KEY=
JWT_SECRET=

# Stripe (Separate Charges and Transfers pattern — see docs/payments.md).
# No real keys yet; these are placeholders until a Stripe account is
# connected. Never commit real values here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate signing secret for the Connect webhook endpoint (account.updated
# etc. from cleaners' connected accounts) — Stripe signs these with a
# different secret than platform-account events. Also covers the
# subscription-billing events (customer.subscription.*, invoice.payment_failed)
# if that endpoint is registered under the same secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
