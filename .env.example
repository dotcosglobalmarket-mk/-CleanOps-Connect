PORT=4000
MONGO_URI=
MAPBOX_API_KEY=
JWT_SECRET=

# Stripe (Separate Charges and Transfers pattern — see docs/payments.md).
# No real keys yet; these are placeholders until a Stripe account is
# connected. Never commit real values here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public address of the website (no trailing slash). Used for Stripe return
# links and links in emails, e.g. https://www.cleanop-connect.co.uk
FRONTEND_URL=

# AI writing help for the job description (optional). Leave ANTHROPIC_API_KEY
# empty to switch the feature off; the API then answers 503 to /jobs/describe.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_DESCRIBE_RATE_LIMIT_MAX=20

# In-app chat: messages a signed-in user can send per minute (default 30).
# CHAT_RATE_LIMIT_MAX=30

# First admin. When the API starts and no admin account exists yet, it creates
# one from these (the password is stored only as a hash, minimum 12 characters).
# It never changes an account that already exists. Once you can log in, create
# other staff from the admin dashboard and remove SUPER_ADMIN_PASSWORD.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin

# Two-step login (admin accounts must use an authenticator app).
# Key that encrypts authenticator secrets in the database. Optional: when unset,
# a key is derived from JWT_SECRET (then changing JWT_SECRET would force every
# admin to set two-step login up again). Any long random string.
TWO_FACTOR_ENCRYPTION_KEY=
# Emergency only: set to false and redeploy if every admin is locked out, sign
# in with the password, then remove it. Anyone who already has two-step login on is still asked.
# ADMIN_2FA_REQUIRED=false

# Recurring bookings (a cleaner and customer agree a repeating series of visits).
# Off by default: leave unset until the recurring screens and charging are released.
# RECURRING_JOBS_ENABLED=true
