# Copy this file to .env.production (or set these as GitHub Actions secrets /
# environment variables passed to `npm run build`) and fill in real values.
# .env.production itself is gitignored — never commit real values.

# Backend API base URL (DigitalOcean App Platform), no trailing slash.
VITE_API_URL=https://cleanops-connect-api.ondigitalocean.app

# Mapbox PUBLIC access token (starts with "pk."), used client-side to render
# the real coverage map on the landing page via the Static Images API. Create
# one at https://account.mapbox.com/access-tokens/ — this is safe to embed in
# frontend code (unlike the backend's MAPBOX_API_KEY, which is a private key
# and must never appear here). Restrict it to your production domain(s) via
# URL restrictions on the Mapbox dashboard.
VITE_MAPBOX_TOKEN=
